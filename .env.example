# Verbatim AI Configuration Environment Variables

# Host & Port
VERBATIM_HOST=127.0.0.1
VERBATIM_PORT=8000

# Force CPU Mode (0 for Auto/GPU, 1 for CPU safe mode)
VERBATIM_FORCE_CPU=0

# Default model on first run ('small', 'medium', or 'large-v3')
VERBATIM_DEFAULT_MODEL=medium

# Upload Limits (in bytes, default 500MB)
VERBATIM_MAX_UPLOAD_BYTES=524288000
